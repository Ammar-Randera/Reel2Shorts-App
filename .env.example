# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# Encryption key for stored credentials (32 bytes hex)
ENCRYPTION_KEY=change-this-to-64-hex-characters-representing-32-bytes

# Google AI (Gemini) for video analysis
GEMINI_API_KEY=your-gemini-api-key

# Apify Actor for Instagram Reel importing
APIFY_API_TOKEN=your-apify-api-token

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/callback

# Publishing
DEFAULT_PUBLISH_INTERVAL_MINUTES=10
MAX_RETRY_ATTEMPTS=3

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
